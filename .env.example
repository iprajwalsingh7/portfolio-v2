# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- database ---------------------------------------------------------------
DATABASE_NAME=portfolio
DATABASE_USER=portfolio
DATABASE_PASSWORD=change-this

# --- privacy ----------------------------------------------------------------
# Mixed into every visitor-IP hash so the stored values cannot be reversed.
# Generate one and never rotate it casually — rotating resets view deduplication.
#   openssl rand -hex 32
IP_SALT=

# --- app --------------------------------------------------------------------
APP_PORT=8080

# --- contact email ----------------------------------------------------------
# Submissions are stored in Postgres regardless. This only controls the
# notification email, so leaving it false is a perfectly usable setup.
CONTACT_MAIL_ENABLED=false

# Where notifications land.
CONTACT_NOTIFY_TO=prajwalsingh0605@gmail.com

# The From address. Leave BLANK to use MAIL_USERNAME — that is the safe default.
# Gmail rejects any From that is not the authenticated account or a verified
# "Send mail as" alias, so a plausible-looking no-reply@yourdomain here is the
# single most common reason mail silently never arrives.
CONTACT_FROM=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
# Gmail requires an App Password (16 characters, 2FA must be on).
# Google Account > Security > 2-Step Verification > App passwords.
# Your normal account password will be rejected.
MAIL_PASSWORD=
